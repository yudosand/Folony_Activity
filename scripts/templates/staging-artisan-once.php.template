<?php

declare(strict_types=1);

// Fixed deployment commands only. Never accept a command from the request.
$expectedToken = '__DEPLOY_TOKEN__';
$providedToken = $_GET['token'] ?? null;
$host = strtolower(explode(':', $_SERVER['HTTP_HOST'] ?? '')[0]);
if ($host !== 'staging-absent.folony.co.id' || !is_string($providedToken)
    || !hash_equals($expectedToken, $providedToken)) {
    http_response_code(404);
    exit('Not found');
}

header('Cache-Control: no-store, private');
header('Referrer-Policy: no-referrer');
header('X-Robots-Tag: noindex, nofollow, noarchive');
header('X-Content-Type-Options: nosniff');
header("Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'");

$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
if ($method === 'GET') {
    header('Content-Type: text/html; charset=utf-8');
    echo '<!doctype html><html lang="id"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">';
    echo '<title>Deploy Folony Staging</title><body style="font:17px system-ui;max-width:640px;margin:60px auto;padding:24px;line-height:1.6">';
    echo '<h1>Selesaikan deploy staging</h1><p>Pastikan ZIP backend terbaru sudah diekstrak ke root Laravel staging dan .env berisi FGG_ENVIRONMENT=staging.</p>';
    echo '<p>Tombol ini menjalankan <code>migrate --force</code>, <code>optimize:clear</code>, dan membuat link storage jika belum ada.</p>';
    echo '<form method="post"><button style="padding:14px 22px;font:inherit;cursor:pointer">Jalankan Artisan Staging</button></form>';
    echo '<p>Helper hanya dapat berhasil sekali dan akan menghapus dirinya setelah selesai.</p></body></html>';
    exit;
}
if ($method !== 'POST') {
    http_response_code(405);
    header('Allow: GET, POST');
    exit('Method not allowed');
}

header('Content-Type: text/plain; charset=utf-8');
@set_time_limit(300);
$root = realpath(__DIR__ . '/..');
if ($root === false || !is_file($root . '/artisan') || !is_file($root . '/vendor/autoload.php')) {
    http_response_code(500);
    exit("Root Laravel tidak ditemukan. Tempatkan helper di folder public Laravel.\n");
}

$lock = @fopen($root . '/storage/framework/folony-deploy-__DEPLOY_RELEASE__.lock', 'c+');
if ($lock === false) {
    http_response_code(500);
    exit("Folder storage/framework harus tersedia dan dapat ditulis oleh PHP.\n");
}
if (!flock($lock, LOCK_EX | LOCK_NB)) {
    fclose($lock);
    http_response_code(409);
    exit("Artisan sedang dijalankan. Tunggu proses pertama selesai.\n");
}
if (str_starts_with((string) stream_get_contents($lock), 'DONE')) {
    flock($lock, LOCK_UN);
    fclose($lock);
    http_response_code(410);
    exit("Deploy ini sudah selesai. Helper tidak dijalankan ulang.\n");
}

try {
    chdir($root);
    require $root . '/vendor/autoload.php';
    $app = require $root . '/bootstrap/app.php';
    $kernel = $app->make(\Illuminate\Contracts\Console\Kernel::class);
    $kernel->bootstrap();

    $commands = [
        ['migrate', ['--force' => true, '--no-interaction' => true]],
        ['optimize:clear', ['--no-interaction' => true]],
    ];
    if (!is_link($root . '/public/storage') && !file_exists($root . '/public/storage')) {
        $commands[] = ['storage:link', ['--no-interaction' => true]];
    }
    $log = "Folony Activity - deploy staging 2026-09-16\n\n";
    foreach ($commands as [$command, $arguments]) {
        $exitCode = $kernel->call($command, $arguments);
        $log .= '> artisan ' . $command . "\n" . $kernel->output() . "\n";
        if ($exitCode !== 0) {
            http_response_code(500);
            echo $log . "GAGAL. Periksa pesan di atas, perbaiki penyebabnya lalu coba lagi.\n";
            exit;
        }
    }
    rewind($lock);
    if (fwrite($lock, 'DONE ' . date('c')) === false || !fflush($lock)) {
        throw new RuntimeException('Cannot persist deployment completion marker');
    }
    echo $log . "DONE - Migrasi dan cache selesai.\n";
    echo "Buka https://staging-absent.folony.co.id/admin/employee-activities\n";
    echo @unlink(__FILE__)
        ? "Helper telah dihapus otomatis.\n"
        : "Hapus public/staging-artisan-once-__DEPLOY_RELEASE__.php secara manual. Helper sudah terkunci agar tidak berjalan ulang.\n";
} catch (Throwable $error) {
    http_response_code(500);
    error_log('Folony staging deploy: ' . $error->getMessage());
    echo "GAGAL: Artisan tidak dapat diselesaikan. Periksa log PHP/Laravel server, kemudian buka link ini kembali.\n";
} finally {
    flock($lock, LOCK_UN);
    fclose($lock);
}
